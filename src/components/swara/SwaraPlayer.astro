---
import './player.css';

export interface Song {
  slug: string;
  title: string;
  meta: Record<string, string>;
  text: string;
}

interface Props {
  songs: Song[];
}

const { songs } = Astro.props;

/* Fold accents so "sri" finds "śrī", and build one haystack per song. */
const fold = (v: string) =>
  (v || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();

const entries = songs.map((song, i) => {
  const parts = [song.title, song.meta.RAGA, song.meta.COMPOSER, song.meta.TALA, song.meta.TAGS]
    .filter(Boolean) as string[];
  return {
    ...song,
    i,
    detail: [song.meta.RAGA, song.meta.COMPOSER, song.meta.TALA].filter(Boolean).join(' · '),
    haystack: fold(parts.join(' ')) + ' ' + fold(song.slug)
  };
});
---

<div class="sp" id="spPlayer">
  <!-- Song text, validated at build time. Rendered as escaped text nodes and
       read by the client with textContent — never as markup. -->
  <div id="spSongs" hidden>
    {songs.map((song) => (
      <pre data-slug={song.slug} data-title={song.title} data-meta={JSON.stringify(song.meta)}>{song.text}</pre>
    ))}
  </div>

  <header class="sp-head">
    <div class="sp-titles">
      <h1 id="spTitle">Swara Player</h1>
      <p id="spMeta" class="sp-by"></p>
    </div>
    {songs.length > 1 && (
      <div class="sp-field sp-song-field">
        <label for="spSearch"><span>Song</span></label>
        <div class="sp-combo">
          <input
            id="spSearch"
            type="text"
            role="combobox"
            aria-expanded="false"
            aria-controls="spSongList"
            aria-autocomplete="list"
            aria-describedby="spCount"
            autocomplete="off"
            placeholder="Search song, raga or composer"
          />
          <button type="button" id="spSearchToggle" class="sp-combo-toggle" aria-label="Show all songs" tabindex="-1">▾</button>
          <ul id="spSongList" class="sp-songlist" role="listbox" aria-label="Songs" hidden>
            {entries.map((song) => (
              <li
                role="option"
                id={`spSongOpt-${song.i}`}
                class="sp-songopt"
                data-index={song.i}
                data-search={song.haystack}
                aria-selected="false"
              >
                <b>{song.title}</b>
                {song.detail && <span>{song.detail}</span>}
              </li>
            ))}
          </ul>
        </div>
        <p class="sp-count" id="spCount" role="status"></p>
      </div>
    )}
  </header>

  <div class="sp-songbar" id="spSongBar"></div>

  <div class="sp-readout-wrap">
    <div class="sp-readout" id="spReadout"></div>
    <div class="sp-progress" aria-hidden="true"><i id="spProgress"></i></div>
  </div>

  <div class="sp-hint sp-loopbar">
    <button type="button" class="sp-btn sp-small" id="spLoopPick" aria-pressed="false">Set A-B</button>
    <button type="button" class="sp-btn sp-small" id="spClearSel" hidden>Clear loop</button>
    <span id="spLoopMsg" aria-live="polite">Tap a swara to play from there, or a line number to loop that line.</span>
  </div>

  <div class="sp-layout">
    <span>Layout</span>
    <div class="sp-seg" role="group" aria-label="Notation layout">
      <button type="button" id="spLayoutWritten" aria-pressed="true">As written</button>
      <button type="button" id="spLayoutCycle" aria-pressed="false">By cycle</button>
    </div>
  </div>

  <div id="spScore" class="sp-score"></div>
  <div id="spGrid" class="sp-gl" hidden></div>

  <details class="sp-settings">
    <summary>Tempo, pitch and sound</summary>
    <div class="sp-grid">
      <label class="sp-field">
        <span>Tempo (BPM)</span>
        <input type="number" id="spBpm" min="20" max="300" step="1" value="60" />
        <input type="range" id="spBpmRange" min="20" max="300" step="1" value="60" aria-label="Tempo slider" />
      </label>
      <label class="sp-field">
        <span>Tonic Sa</span>
        <select id="spTonic" aria-label="Tonic key">
          {['C','C#','D','D#','E','F','F#','G','G#','A','A#','B'].map((k) => <option value={k}>{k}</option>)}
        </select>
      </label>
      <label class="sp-field">
        <span>Octave</span>
        <select id="spOctave" aria-label="Tonic octave">
          {[2,3,4,5].map((n) => <option value={n}>{n}</option>)}
        </select>
      </label>
      <label class="sp-field">
        <span>Loop</span>
        <select id="spLoop">
          <option value="off">Off</option>
          <option value="song">Whole song</option>
          <option value="section">Current section</option>
          <option value="selection">Selected passage</option>
        </select>
      </label>
      <label class="sp-field sp-check">
        <input type="checkbox" id="spSubClick" />
        <span>Click on every note-space</span>
      </label>
      <label class="sp-field">
        <span>Volume</span>
        <input type="range" id="spVolMaster" min="0" max="1" step="0.01" value="0.85" aria-label="Master volume" />
      </label>
      <label class="sp-field">
        <span>Notes</span>
        <input type="range" id="spVolPiano" min="0" max="1" step="0.01" value="0.8" aria-label="Note volume" />
      </label>
      <label class="sp-field">
        <span>Click</span>
        <input type="range" id="spVolClick" min="0" max="1" step="0.01" value="0.5" aria-label="Metronome volume" />
      </label>
    </div>
    <p class="sp-keys">
      Keyboard: <kbd>Space</kbd> play or pause · <kbd>S</kbd> stop · <kbd>R</kbd> restart ·
      <kbd>M</kbd> click · <kbd>←</kbd> <kbd>→</kbd> tempo
    </p>
  </details>

  <div class="sp-transport" role="group" aria-label="Playback controls">
    <div class="sp-transport-inner">
      <button type="button" class="sp-btn sp-primary" id="spPlay" aria-label="Play">▶ Play</button>
      <button type="button" class="sp-btn" id="spStop" aria-label="Stop">■</button>
      <button type="button" class="sp-btn" id="spRestart" aria-label="Restart from the beginning">↺</button>
      <button type="button" class="sp-btn on" id="spMetro" aria-pressed="true" aria-label="Metronome on or off">Click</button>
      <button type="button" class="sp-btn" id="spSubMini" aria-pressed="false" aria-label="Click every note-space">Subs</button>
      <span class="sp-bpm-mini">
        <label for="spBpmMini">BPM</label>
        <input type="number" id="spBpmMini" min="20" max="300" value="60" aria-label="Tempo in beats per minute" />
      </span>
      <span class="sp-spacer"></span>
      <span class="sp-now" id="spNow">Ready</span>
    </div>
  </div>
</div>

<script>
  import '../../components/swara/player.js';
</script>
