---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactCTA from '../components/ContactCTA.astro';
import Hero from '../components/Hero.astro';
import '../styles/notations.css';

// Initial values
const searchQuery = '';
const currentPage = 1;
const itemsPerPage = 16;
---

<BaseLayout
  title="Notations | Mandolin Balaji"
  description="Carnatic music notations"
>
  <div class="stack gap-20">
    <main class="wrapper stack gap-8">
      <Hero
        title="Notations"
        align="center"
      />

      <!-- Controls and Search -->
      <div class="controls" id="searchControls">
        <div class="search-form">
          <div class="search-wrapper">
            <input
            type="text"
            id="searchInput"
            value={searchQuery}
            placeholder="Search notations..."
            class="search-input"
            aria-label="Search notations"
            />
          </div>
          <div class="search-button-wrapper">
            <button id="searchButton" class="search-button" aria-label="Search">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            Search
            </button>
            <button id="clearButton" class="search-button" aria-label="Clear">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="#FFF" viewBox="0 0 256 256">
              <path d="M205.66,194.34a8,8,0,0,1-11.32,11.32L128,139.31,61.66,205.66a8,8,0,0,1-11.32-11.32L116.69,128,50.34,61.66A8,8,0,0,1,61.66,50.34L128,116.69l66.34-66.35a8,8,0,0,1,11.32,11.32L139.31,128Z"></path>
            </svg>
            Clear
            </button>
          </div>
        </div>

        <p class="no-results" style="display: none;">No notations found matching your search.</p>
        <p class="results-count" style="display: none;"></p>
      </div>

      <!-- Detail view with back button -->
      <div id="detailView" style="display: none;">
        <button id="backButton" class="back-button">← Back to Notations</button>
        <h2 id="detailTitle"></h2>
        
        <!-- Font controls -->
        <div class="font-controls">
          <div class="control-group">
            <label for="fontFamily">Font:</label>
            <select id="fontFamily" class="font-select">
              <option value="'Courier New', monospace">Courier New</option>
              <option value="'Monaco', monospace">Monaco</option>
              <option value="'Consolas', monospace">Consolas</option>
              <option value="'Liberation Mono', monospace">Liberation Mono</option>
              <option value="monospace">Monospace (Default)</option>
            </select>
          </div>
          <div class="control-group">
            <label for="fontSize">Size: <span id="fontSizeValue">0.95</span>rem</label>
            <input type="range" id="fontSize" class="font-slider" min="0.7" max="1.5" step="0.05" value="0.95">
          </div>
        </div>

        <div id="detailContent"></div>
      </div>

      <!-- Pagination controls at the top -->
      <div class="pagination" id="paginationControls">
        <div id="paginationContainer"></div>
      </div>

      <!-- Notations grid -->
      <div id="notationsContainer" class="notations-grid">
        <!-- Notations will be inserted here by JavaScript -->
      </div>

      <!-- Pagination controls at the bottom -->
      <div class="pagination" id="paginationControlsBottom">
        <div id="paginationContainerBottom"></div>
      </div>
    </main>
    <ContactCTA />
  </div>
</BaseLayout>

<script>
  document.addEventListener('DOMContentLoaded', async () => {
    const searchInput = document.getElementById('searchInput');
    const searchButton = document.getElementById('searchButton');
    const clearButton = document.getElementById('clearButton');
    const notationsContainer = document.getElementById('notationsContainer');
    const paginationContainer = document.getElementById('paginationContainer');
    const paginationContainerBottom = document.getElementById('paginationContainerBottom');
    const resultsCount = document.querySelector('.results-count');
    const noResults = document.querySelector('.no-results');
    let currentPage = 1;
    const itemsPerPage = 16;
    let allNotations = [];
    let filteredNotations = [];

    // Fetch notations from local notesfromtext folder
    async function fetchNotations() {
      try {
        const response = await fetch('/notesfromtext/index.json?t=' + Date.now(), {
          cache: 'no-store',
          headers: {
            'Cache-Control': 'no-cache, no-store, must-revalidate'
          }
        });
        if (!response.ok) {
          throw new Error(`HTTP error! status: ${response.status}`);
        }
        const songs = await response.json();
        allNotations = songs.map(name => ({
          name: name,
          url: `/notesfromtext/${name}.txt`
        }));
        filteredNotations = [...allNotations];
        renderPage();
      } catch (error) {
        console.error('Error fetching notations:', error);
        notationsContainer.innerHTML = '<p>Error loading notations. The notesfromtext folder may be inaccessible.</p>';
      }
    }

    // Render the current page
    function renderPage() {
      const startIndex = (currentPage - 1) * itemsPerPage;
      const endIndex = startIndex + itemsPerPage;
      const pageNotations = filteredNotations.slice(startIndex, endIndex);

      notationsContainer.innerHTML = pageNotations.map(notation => `
        <div class="notation-item" data-url="${notation.url}" style="cursor: pointer;">
          <div class="notation-cover">
            <h3 class="notation-title">${notation.name}</h3>
          </div>
        </div>
      `).join('');

      renderPagination();
      updateResultsCount();
    }

    // Render pagination
    function renderPagination() {
      const totalPages = Math.ceil(filteredNotations.length / itemsPerPage);
      const paginationHTML = generatePaginationHTML(totalPages);
      paginationContainer.innerHTML = paginationHTML;
      paginationContainerBottom.innerHTML = paginationHTML;

      // Add event listeners
      document.querySelectorAll('.pagination-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const page = parseInt(e.target.dataset.page);
          if (page && page !== currentPage) {
            currentPage = page;
            renderPage();
          }
        });
      });
    }

    function generatePaginationHTML(totalPages) {
      let html = '';
      const maxVisible = 5;
      let startPage = Math.max(1, currentPage - Math.floor(maxVisible / 2));
      let endPage = Math.min(totalPages, startPage + maxVisible - 1);

      if (endPage - startPage + 1 < maxVisible) {
        startPage = Math.max(1, endPage - maxVisible + 1);
      }

      if (startPage > 1) {
        html += `<button class="pagination-btn" data-page="1">1</button>`;
        if (startPage > 2) {
          html += `<span>...</span>`;
        }
      }

      for (let i = startPage; i <= endPage; i++) {
        html += `<button class="pagination-btn ${i === currentPage ? 'active' : ''}" data-page="${i}">${i}</button>`;
      }

      if (endPage < totalPages) {
        if (endPage < totalPages - 1) {
          html += `<span>...</span>`;
        }
        html += `<button class="pagination-btn" data-page="${totalPages}">${totalPages}</button>`;
      }

      return html;
    }

    // Update results count
    function updateResultsCount() {
      const total = filteredNotations.length;
      if (total > 0) {
        resultsCount.textContent = `Showing ${Math.min(total, itemsPerPage)} of ${total} notations`;
        resultsCount.style.display = 'block';
        noResults.style.display = 'none';
      } else {
        resultsCount.style.display = 'none';
        noResults.style.display = 'block';
      }
    }

    // Detail view elements
    const detailView = document.getElementById('detailView');
    const searchControls = document.getElementById('searchControls');
    const paginationControls = document.getElementById('paginationControls');
    const paginationControlsBottom = document.getElementById('paginationControlsBottom');
    const detailTitle = document.getElementById('detailTitle');
    const detailContent = document.getElementById('detailContent');
    const backButton = document.getElementById('backButton');

    // Show list view
    function showListView() {
      detailView.style.display = 'none';
      searchControls.style.display = 'flex';
      paginationControls.style.display = 'block';
      paginationControlsBottom.style.display = 'block';
      notationsContainer.style.display = 'grid';
    }

    // Show detail view
    async function showDetailView(name, url) {
      try {
        const response = await fetch(url + '?t=' + Date.now(), {
          cache: 'no-store',
          headers: {
            'Cache-Control': 'no-cache, no-store, must-revalidate'
          }
        });
        if (!response.ok) throw new Error('Failed to load content');
        const text = await response.text();
        
        // Extract metadata - try both MetaS/MetaE and infoS/infoE formats
        let metadataHTML = '';
        let contentText = text;
        
        // Try MetaS/MetaE format first
        let metaRegex = /MetaS:\s*(.*?)\s*MetaE:/s;
        let metaMatch = text.match(metaRegex);
        
        // If not found, try infoS/infoE format
        if (!metaMatch) {
          metaRegex = /infoS:\s*(.*?)\s*infoE:/s;
          metaMatch = text.match(metaRegex);
        }
        
        if (metaMatch) {
          const metaContent = metaMatch[1].trim();
          const metaItems = metaContent.split('|').map(item => item.trim());
          metadataHTML = '<div class="metadata-box">';
          metaItems.forEach(item => {
            if (item) {
              const [key, value] = item.split(':').map(s => s.trim());
              if (key && value) {
                metadataHTML += `<div class="meta-item"><span class="meta-key">${key}:</span> <span class="meta-value">${value}</span></div>`;
              }
            }
          });
          metadataHTML += '</div>';
        }

        // Remove metadata from text for section parsing - handle both formats
        contentText = text.replace(/MetaS:.*?MetaE:/s, '').replace(/infoS:.*?infoE:/s, '').trim();
        
        // Parse sections with line numbering
        const lines = contentText.split('\n');
        let sectionsHTML = '';
        let currentSection = null;
        let sectionContent = '';
        let lineNumber = 0;

        lines.forEach(line => {
          line = line.trim();
          if (!line) return;

          // Check if line is a section header (ends with colon and not Line: or LR:)
          if (line.endsWith(':') && !line.startsWith('Line:') && !line.startsWith('LR:')) {
            // Save previous section
            if (currentSection) {
              sectionsHTML += `<div class="section-box"><h3 class="section-heading">${currentSection}</h3><pre class="section-content">${sectionContent.trim()}</pre></div>`;
            }
            currentSection = line.slice(0, -1); // Remove the colon
            sectionContent = '';
            lineNumber = 0; // Reset line number for new section
          } else if (currentSection) {
            // Count Line: and LR: pairs
            if (line.startsWith('Line:')) {
              lineNumber++;
              const lineContent = line.replace(/^Line:\s*/, '').trim();
              sectionContent += `[${lineNumber}] ${lineContent}\n`;
            } else if (line.startsWith('LR:')) {
              const lrContent = line.replace(/^LR:\s*/, '').trim();
              sectionContent += `    ${lrContent}\n`;
            } else {
              sectionContent += line + '\n';
            }
          }
        });

        // Save last section
        if (currentSection) {
          sectionsHTML += `<div class="section-box"><h3 class="section-heading">${currentSection}</h3><pre class="section-content">${sectionContent.trim()}</pre></div>`;
        }

        detailTitle.textContent = name;
        detailContent.innerHTML = metadataHTML + (sectionsHTML || `<pre class="notation-text">${text}</pre>`);
        
        searchControls.style.display = 'none';
        paginationControls.style.display = 'none';
        paginationControlsBottom.style.display = 'none';
        notationsContainer.style.display = 'none';
        detailView.style.display = 'block';
        
        // Scroll to top
        window.scrollTo(0, 0);
      } catch (error) {
        console.error('Error loading notation:', error);
        detailTitle.textContent = 'Error';
        detailContent.innerHTML = '<p>Error loading notation content.</p>';
      }
    }

    // Handle notation click
    function handleNotationClick(event) {
      const item = event.target.closest('.notation-item');
      if (item) {
        const name = item.querySelector('.notation-title').textContent;
        const url = item.dataset.url;
        if (url) {
          showDetailView(name, url);
        }
      }
    }

    // Handle search
    function handleSearch() {
      const query = searchInput.value.toLowerCase().trim();
      filteredNotations = allNotations.filter(notation =>
        notation.name.toLowerCase().includes(query)
      );
      currentPage = 1;
      renderPage();
    }

    // Event listeners
    searchButton.addEventListener('click', handleSearch);
    clearButton.addEventListener('click', () => {
      searchInput.value = '';
      handleSearch();
    });
    searchInput.addEventListener('input', handleSearch);

    // Back button listener
    backButton.addEventListener('click', showListView);

    // Notation click listener (delegated)
    notationsContainer.addEventListener('click', handleNotationClick);

    // Font family control
    const fontFamilySelect = document.getElementById('fontFamily');
    fontFamilySelect.addEventListener('change', (e) => {
      document.querySelectorAll('.section-content').forEach(el => {
        el.style.fontFamily = e.target.value;
      });
      localStorage.setItem('notationFontFamily', e.target.value);
    });

    // Font size control
    const fontSizeSlider = document.getElementById('fontSize');
    const fontSizeValue = document.getElementById('fontSizeValue');
    fontSizeSlider.addEventListener('input', (e) => {
      const size = e.target.value;
      fontSizeValue.textContent = size;
      document.querySelectorAll('.section-content').forEach(el => {
        el.style.fontSize = size + 'rem';
      });
      localStorage.setItem('notationFontSize', size);
    });

    // Load saved font preferences
    const savedFontFamily = localStorage.getItem('notationFontFamily');
    const savedFontSize = localStorage.getItem('notationFontSize');
    if (savedFontFamily) {
      fontFamilySelect.value = savedFontFamily;
      document.querySelectorAll('.section-content').forEach(el => {
        el.style.fontFamily = savedFontFamily;
      });
    }
    if (savedFontSize) {
      fontSizeSlider.value = savedFontSize;
      fontSizeValue.textContent = savedFontSize;
      document.querySelectorAll('.section-content').forEach(el => {
        el.style.fontSize = savedFontSize + 'rem';
      });
    }

    // Initial load
    await fetchNotations();
  });
</script>