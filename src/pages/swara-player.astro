---
import BaseLayout from '../layouts/BaseLayout.astro';
import SwaraPlayer from '../components/swara/SwaraPlayer.astro';
import E from '../lib/swara/engine.js';

/* Songs are plain text files under src/content/songs. They are read at build
   time and parsed with the same engine the player uses. A song with a mistake
   in it does not fail the build: the problems are logged here and handed to
   the player, which shows them instead of loading that song. */
const files = import.meta.glob('../content/songs/*.txt', { query: '?raw', import: 'default', eager: true });

const songs = Object.entries(files as Record<string, string>).map(([path, raw]) => {
  const slug = (path.split('/').pop() || '').replace(/\.txt$/, '');
  const text = raw.replace(/^﻿/, '');
  const meta: Record<string, string> = {};
  const problems: string[] = [];

  const probe = E.parse(text, {});
  Object.assign(meta, probe.meta || {});

  /* A raga the engine does not ship is built from the song's own [SCALE:] or a
     numbered [AROHANA:], so adding a raga needs no code change. */
  let raga = 'Chromatic (all swaras)';
  if (meta.RAGA) {
    if (E.RAGAS[meta.RAGA]) {
      raga = meta.RAGA;
    } else {
      const derived = E.swarasFromScale(meta.SCALE || meta.AROHANA);
      if (!derived) {
        problems.push(
          `Unknown raga "${meta.RAGA}". Add [SCALE: S R2 G3 M1 P D2 N3] to the song ` +
          `(variant numbers included), or add the raga to the RAGAS table in src/lib/swara/engine.js.`
        );
      } else {
        E.registerRaga(meta.RAGA, {
          swaras: derived.swaras,
          defaults: derived.defaults,
          arohana: meta.AROHANA || '',
          avarohana: meta.AVAROHANA || ''
        });
        raga = meta.RAGA;
      }
    }
  }
  const parsed = E.parse(text, { raga });

  parsed.errors.forEach((e: any) => {
    problems.push(`Line ${e.line + 1}, col ${e.column + 1}: ${e.message}`);
  });
  if (!parsed.events.length && !problems.length) {
    problems.push('No swaras found — is the [SWARA] marker missing?');
  }
  if (problems.length) {
    console.warn(
      `[swara-player] src/content/songs/${slug}.txt has ${problems.length} problem(s); ` +
      `the player will show them instead of loading the song:\n  ${problems.join('\n  ')}`
    );
  }

  // Cycle drift is reported, not fatal — a fragment may legitimately not close.
  const beats = parseInt(meta.BEATS || '', 10);
  const nadai = parseInt(meta.NADAI || '', 10);
  if (!problems.length && beats > 0 && nadai > 0) {
    const report = E.cycleReport(parsed, { beatsPerCycle: beats, subdivisionsPerBeat: nadai });
    if (!report.aligned) {
      // One short line per line of notation — no passage totals to count through.
      const cyc = report.cycleSpaces;
      const lines = report.offenders.length
        ? report.offenders.map((r: any) => {
            const over = r.endOffset;
            const gap = over <= cyc - over ? `${over} too many` : `${cyc - over} missing`;
            return `  line ${r.line + 1} — ${r.spaces} note-spaces, ${gap}`;
          })
        : [`  the last line ends ${report.remainder} note-spaces past a full cycle`];
      console.warn(
        `[swara-player] ${slug}: a cycle is ${cyc} note-spaces` +
        ', counted from sam; each || should land on a cycle' +
        `\n${lines.join('\n')}`
      );
    }
  }

  return { slug, title: parsed.title || meta.SONG || slug.replace(/[-_]+/g, ' '), meta, text, problems };
}).sort((a, b) => a.title.localeCompare(b.title));
---

<BaseLayout
  title="Swara Player | Mandolin Balaji"
  description="Play Carnatic swara notation with aligned sahitya — raga-aware pitch, tala metronome, adjustable tempo and tonic, looping by section or passage."
>
  {songs.length === 0 ? (
    <div class="wrapper stack gap-8">
      <p>No songs yet. Add a notation file to <code>src/content/songs/</code>.</p>
    </div>
  ) : (
    <SwaraPlayer songs={songs} />
  )}
</BaseLayout>
